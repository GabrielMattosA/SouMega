generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  rga String @unique
  cargo String?
  diretoria String?
  time String?
  projects Project[]
}

model Project {
  id Int @id @default(autoincrement())
  title String
  description String?
  status String
  githubLink String
  deployLink String
  memberId Int
  member Member @relation(fields: [memberId], references: [id])
}