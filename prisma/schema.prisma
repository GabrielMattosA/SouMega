generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  rga       String    @unique
  cargo     String?
  diretoria String?
  time      String?
  projects  Project[]
  password String
}

model Project {
  id          Int      @id @default(autoincrement())
  status      String
  description String?
  name        String
  prazo       String
  members     Member[]
}