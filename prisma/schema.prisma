generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBRO
  DIRETOR
  PRESIDENTE
}

model Member {

  id Int @id @default(autoincrement())

  name String

  email String @unique

  rga String @unique

  role Role

  projects Project[]

}

model Project {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  memberId Int
  member   Member @relation(fields: [memberId], references: [id])
}